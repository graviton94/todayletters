<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 4×2 (v21 4단계 D3): 왼쪽 오늘 편지의 그림, 오른쪽 편지 번호 · 첫 줄 · 번역 · 새 편지 · 복습 · 이어 읽기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal">
    <ImageView android:id="@+id/w_art"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="38"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="62"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/w_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:letterSpacing="0.16" android:maxLines="1"
            android:textColor="@color/widget_gilt" android:textSize="10sp" />
        <TextView android:id="@+id/w_line"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:ellipsize="end" android:maxLines="3"
            android:fontFamily="serif" android:textStyle="italic"
            android:textColor="@color/widget_ink" android:textSize="16sp"
            android:text="@string/app_name" />
        <TextView android:id="@+id/w_read"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:fontFamily="serif" android:textColor="@color/widget_soft" android:textSize="11sp" />
        <TextView android:id="@+id/w_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="1"
            android:fontFamily="serif" android:textColor="@color/widget_ink" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
