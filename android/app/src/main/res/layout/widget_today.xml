<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯: 날짜 · 오늘의 문장 · 번역 · 상태 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/w_date"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="serif" android:letterSpacing="0.16"
        android:textColor="#8F6A27" android:textSize="10sp" />
    <TextView android:id="@+id/w_line"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end" android:maxLines="3"
        android:fontFamily="serif" android:textStyle="italic"
        android:textColor="#2A2118" android:textSize="17sp"
        android:text="@string/app_name" />
    <TextView android:id="@+id/w_read"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="2"
        android:fontFamily="serif" android:textColor="#6E6150" android:textSize="12sp" />
    <TextView android:id="@+id/w_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif" android:textColor="#2A2118" android:textSize="12sp" />
</LinearLayout>
