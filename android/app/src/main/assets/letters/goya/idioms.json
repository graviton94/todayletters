{"_doc":"Idioms of this series for this learning language (scripts/notes.py from scripts/idioms/<series>[_deck].txt). lem = lexicon keys (lowercase, space separated) matched in a row against gloss tokens; t = shown form; ko/en = short meaning; note_ko/note_en = optional one-line note; n = letters it appears in; first = [letter id, message index]. Patterns win over idioms, idioms over anchors.","lang":"es","checked":false,"idioms":[{"lem":"tal vez","t":"tal vez","ko":"아마","en":"perhaps","n":3,"first":["p2",0]},{"lem":"a menudo","t":"a menudo","ko":"자주","en":"often","n":1,"first":["c3-l5",2]},{"lem":"ya que","t":"ya que","ko":"~이니까","en":"since","n":1,"first":["c4-l2",0]},{"lem":"después de","t":"después de","ko":"~한 뒤에","en":"after","n":4,"first":["c2-l1",1]},{"lem":"debajo de","t":"debajo de","ko":"~ 아래에","en":"under","n":1,"first":["c2-l4",1]},{"lem":"dentro de","t":"dentro de","ko":"~ 안에","en":"inside","n":1,"first":["c6-l4",2]},{"lem":"por ese","t":"por eso","ko":"그래서","en":"that's why","n":1,"first":["c6-l3",0]},{"lem":"en fin","t":"en fin","ko":"결국, 요컨대","en":"in short","n":3,"first":["c1-l4",1]},{"lem":"de modo que","t":"de modo que","ko":"그래서 ~하도록","en":"so that","n":1,"first":["c5-l7",1]},{"lem":"lo demás","t":"lo demás","ko":"나머지","en":"the rest","n":1,"first":["c1-l6",1]},{"lem":"a mí","t":"a mí","ko":"나에게","en":"to me","n":3,"first":["c2-l3",0]},{"lem":"dar gracia","t":"doy gracias","ko":"감사하다","en":"to give thanks","n":2,"first":["c1-l1",1]},{"lem":"a gusto","t":"a gusto","ko":"마음 편히","en":"at ease","n":1,"first":["c4-l5",0]},{"lem":"si dios querer","t":"si Dios quiere","ko":"하느님이 허락하시면","en":"God willing","n":2,"first":["c2-l4",3]},{"lem":"en casa","t":"en casa","ko":"집에","en":"at home","n":1,"first":["c4-l6",1]},{"lem":"vuestro merced","t":"vuestra merced","ko":"귀하 (옛 높임)","en":"Your Grace (old polite you)","n":3,"first":["c1-l3",0]},{"lem":"mi señor","t":"mi señor","ko":"나의 주인님","en":"my lord","n":1,"first":["c6-l6",3]},{"lem":"acordar de","t":"acordado de","ko":"~을 기억하다","en":"to remember","note_ko":"acordarse de = ‘~을 기억하다’ (se 와 함께) 예요.","note_en":"Acordarse de means “to remember”.","n":4,"first":["p3",0]},{"lem":"pues parecer que","t":"pues parece que","ko":"아무래도 ~인 것 같다","en":"it seems that","n":3,"first":["p3",0]},{"lem":"por mi mano","t":"por mi mano","ko":"내 손으로","en":"by my own hand","n":3,"first":["c1-l3",0]},{"lem":"nuestro señora","t":"Nuestra Señora","ko":"성모","en":"Our Lady","n":3,"first":["c1-l6",1]},{"lem":"a ver","t":"a ver","ko":"어디 보자","en":"let's see","n":3,"first":["c2-l4",3]},{"lem":"no tener tiempo","t":"no tengo tiempo","ko":"시간이 없다","en":"to have no time","n":3,"first":["c1-l1",2]},{"lem":"besar el mano","t":"besé la mano","ko":"손에 입 맞추다 (공손한 인사)","en":"to kiss the hand (respectful greeting)","n":2,"first":["c1-l5",2]}]}
