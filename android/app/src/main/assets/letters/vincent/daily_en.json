[{"t":"harvest time","m":0,"ko":"추수 때","en":"the season of gathering crops","note_ko":"harvest: 수확. 밀을 거두는 여름철.","note_en":"The time when crops are gathered."},{"t":"don't always come true","m":3,"ko":"늘 이루어지지는 않는다","en":"do not always become real","note_ko":"come true: (소원·꿈이) 이루어지다.","note_en":"\"Come true\" = a wish or dream becomes real."}]},"c2-l4":{"words":["once","read","just","paint","whole","girl","case","figure"],"spots":[],"phrases":[{"t":"I've just painted one","m":0,"ko":"방금 하나 그렸어","en":"I painted one very recently","note_ko":"have just + 과거분사: 방금 ~했다.","note_en":"\"Have just\" + past participle = a moment ago."},{"t":"It took my whole week","m":1,"ko":"그거 하나에 한 주가 다 갔다","en":"it used all my week","note_ko":"It took + 시간: (시간이) 걸렸다.","note_en":"\"It took\" + time = it needed that much time."}]},"c2-l5":{"words":["gold","old","money","pay","matter","head","hand","dark"],"spots":[],"phrases":[{"t":"under way","m":2,"ko":"진행 중인","en":"in progress","note_ko":"아직 끝나지 않고 작업 중일 때.","note_en":"Something under way has started and is going on."},{"t":"matter more to me than everything else","m":2,"ko":"무엇보다 중요하다","en":"are the most important to me","note_ko":"matter: '중요하다' (동사).","note_en":"\"Matter\" as a verb means \"be important\"."}]},"c2-l6":{"words":["sort","man","try","use","simple","rich","high","life"],"spots":[],"phrases":[{"t":"make the acquaintance of","m":0,"ko":"~을 알게 되다","en":"meet and get to know","note_ko":"공손하게 '처음 만나다'.","note_en":"A formal way to say \"meet\"."},{"t":"instead of trying to","m":1,"ko":"~하려 애쓰는 대신","en":"rather than trying to","note_ko":"instead of + -ing: '~하는 대신'.","note_en":"\"Instead of\" + -ing = rather than doing."}]},"c2-l7":{"words":["surprise","hope","living","studio","own","thing","morning","clearly"],"spots":[],"phrases":[{"t":"which won't surprise you","m":0,"ko":"놀랍지도 않겠지","en":"you won't be surprised by this","note_ko":"상대가 당연히 예상할 일을 말할 때.","note_en":"Said of something the listener expects."},{"t":"in one go","m