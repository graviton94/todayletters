{"chunks": [{"s": 0.15, "e": 1.652, "text": "My dear Theo,"}, {"s": 2.009, "e": 4.041, "text": "I'm in a frenzy of work"}, {"s": 4.194, "e": 6.803, "text": "because the trees are in blossom"}, {"s": 7.16, "e": 9.098, "text": "and I wanted to paint"}, {"s": 9.251, "e": 11.171, "text": "a Provençal orchard"}, {"s": 11.324, "e": 13.426, "text": "of enormous cheerfulness."}]}