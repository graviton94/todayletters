{"chunks": [{"s": 0.15, "e": 3.075, "text": "And the landscapes under the snow,"}, {"s": 3.495, "e": 5.296, "text": "with white peaks"}, {"s": 5.476, "e": 8.7, "text": "against a sky as bright as the snow,"}, {"s": 9.12, "e": 10.825, "text": "were just like"}, {"s": 11.005, "e": 13.141, "text": "the winter landscapes"}, {"s": 13.321, "e": 15.187, "text": "the Japanese made."}]}