{"chunks": [{"s": 0.15, "e": 2.278, "text": "Here I see new things,"}, {"s": 2.458, "e": 3.95, "text": "I learn,"}, {"s": 4.37, "e": 5.935, "text": "and treated"}, {"s": 6.115, "e": 8.444, "text": "with a little gentleness,"}, {"s": 8.864, "e": 10.345, "text": "my body"}, {"s": 10.525, "e": 12.774, "text": "doesn't refuse to serve me."}]}