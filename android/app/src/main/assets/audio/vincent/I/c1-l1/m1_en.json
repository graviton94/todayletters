{"chunks": [{"s": 0.15, "e": 1.785, "text": "My dear Theo,"}, {"s": 2.205, "e": 3.83, "text": "on the journey"}, {"s": 4.01, "e": 5.847, "text": "I thought about you"}, {"s": 6.027, "e": 8.191, "text": "at least as much as"}, {"s": 8.371, "e": 10.402, "text": "about the new country"}, {"s": 10.582, "e": 12.212, "text": "I was seeing."}]}