{"chunks": [{"s": 0.15, "e": 2.449, "text": "My dear Theo,"}, {"s": 2.932, "e": 4.52, "text": "… well,"}, {"s": 5.003, "e": 6.899, "text": "today I've rented"}, {"s": 7.106, "e": 9.759, "text": "the right wing of this building,"}, {"s": 10.242, "e": 12.616, "text": "which has 4 rooms,"}, {"s": 12.823, "e": 14.489, "text": "or rather two,"}, {"s": 14.696, "e": 16.899, "text": "with two small rooms."}]}