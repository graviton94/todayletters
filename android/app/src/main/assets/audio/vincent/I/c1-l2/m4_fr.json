{"chunks": [{"s": 0.15, "e": 2.796, "text": "Les femmes sont bien belles ici,"}, {"s": 3.153, "e": 5.108, "text": "c'est pas une blague,"}, {"s": 5.465, "e": 6.993, "text": "par contraire"}, {"s": 7.146, "e": 9.41, "text": "le musée d'Arles est atroce"}, {"s": 9.563, "e": 11.096, "text": "et une blague,"}, {"s": 11.453, "e": 13.609, "text": "et digne d'être à Tarascon."}]}