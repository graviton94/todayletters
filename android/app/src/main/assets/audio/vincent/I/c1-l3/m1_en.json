{"chunks": [{"s": 0.15, "e": 1.754, "text": "As for work,"}, {"s": 2.174, "e": 4.28, "text": "today I brought back"}, {"s": 4.46, "e": 7.088, "text": "a size 15 canvas:"}, {"s": 7.508, "e": 9.105, "text": "a drawbridge"}, {"s": 9.285, "e": 12.432, "text": "with a little carriage going over it,"}, {"s": 12.852, "e": 15.36, "text": "outlined against a blue sky."}]}