{"_doc":"Function-word notes, constructions and grammar hints for the reading room (scripts/notes.py from scripts/notes/<lang>.txt; do not edit by hand). words: lexicon key -> {tag, short, note} (ko/en each). endings (ko only): gloss_ko fn piece 'form/TAG' -> same + show (append short to the word gloss). classes: name -> list of token specs (any). patterns: tried in order; seq = token specs (lemma = lexicon keys lowercase, form = Anchors.norm of the surface, pos = lexicon pos, re = full regex on the lowercase surface, fn = regex found in the ko fn, cls = classes (all must match), infl = surface differs from lemma, upper = surface starts with a capital, not = specs that must not match) with role mark|head|part; gap = max tokens between parts; stop = specs a gap token must not match; next_not / prev_not = specs for the token after the last / before the first part; always = show even when function glosses are off; compound = German separable verb (part 2 form + part 1 lemma must be a lexicon key; short is that entry's meaning). Matching: core NoteBook.","v":1,"lang":"ko","classes":{"go":[{"fn":"(^|\\+)고/EC($|\\+)"}],"eo":[{"fn":"(^|\\+)(어|아|여)/EC($|\\+)"}],"ji":[{"fn":"(^|\\+)지/EC($|\\+)"}],"eoya":[{"fn":"(^|\\+)(어야|아야|여야)/EC($|\\+)"}],"ge":[{"fn":"(^|\\+)게/EC($|\\+)"}],"ryeogo":[{"fn":"(^|\\+)(려고|으려고)/EC($|\\+)"}],"eodo":[{"fn":"(^|\\+)(어도|아도|여도)/EC($|\\+)"}],"myeon":[{"fn":"(^|\\+)(면|으면)/EC($|\\+)"}],"etm_l":[{"fn":"(^|\\+)(ㄹ|을)/ETM($|\\+)"}],"etm_past":[{"fn":"(^|\\+)(ㄴ|은)/ETM($|\\+)"}],"etm":[{"fn":"(^|\\+)(ㄴ|은|는|ㄹ|을|던)/ETM($|\\+)"}],"etn_gi":[{"fn":"(^|\\+)기/ETN($|\\+)"}],"lkka":[{"fn":"(^|\\+)(ㄹ까|을까)/EC($|\\+)"}]},"words":{"나":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"나","en":"I, me"},"note":{"ko":"나 는 ‘나’ (반말 · 혼잣말) 예요. 높이면 저. 나는 → 난, 나를 → 날, 나의 → 내.","en":"나 means “I / me” (casual); polite 저. 나는 → 난, 나를 → 날, 나의 → 내."}},"저":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"저","en":"I (polite)"},"note":{"ko":"저 는 자기를 낮추는 ‘나’ 예요 (저의 → 제).","en":"저 is the humble “I” (저의 → 제)."}},"너":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"너","en":"you"},"note":{"ko":"너 는 친한 사이의 ‘너’ 예요 (너의 → 네).","en":"너 is the familiar “you” (너의 → 네)."}},"당신":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"당신","en":"you"},"note":{"ko":"당신 은 편지 · 부부 사이에 쓰는 ‘당신’ 이에요. 얼굴 보고 남에게 쓰면 무례할 수 있어요.","en":"당신 means “you” in letters or between spouses; to a stranger it can sound rude."}},"우리":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"우리","en":"we, our"},"note":{"ko":"우리 는 ‘우리’, 또 ‘우리 집 · 우리 엄마’ 처럼 ‘나의’ 뜻으로도 써요.","en":"우리 means “we”, and also “my” in 우리 집, 우리 엄마."}},"너희":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"너희","en":"you (pl.)"},"note":{"ko":"너희 는 ‘너희들’ 이에요.","en":"너희 means “you (plural)”."}},"그녀":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"그녀","en":"she"},"note":{"ko":"그녀 는 글말의 ‘그 여자’ 예요. 말할 때는 잘 안 써요.","en":"그녀 is a written “she”; it is rare in speech."}},"그분":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"그분","en":"he, she (hon.)"},"note":{"ko":"그분 은 높이는 ‘그 사람’ 이에요.","en":"그분 is the honorific “that person”."}},"자기":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"자기","en":"oneself"},"note":{"ko":"자기 는 ‘자기 자신’ 이에요.","en":"자기 means “oneself”."}},"있다":{"tag":{"ko":"보조 용언","en":"Auxiliary verb"},"short":{"ko":"있다","en":"there is, have"},"note":{"ko":"있다 는 ‘있다, 가지고 있다’ 예요. -고 있다 는 진행, -아/어 있다 는 상태.","en":"있다 means “to be (there) / to have”; -고 있다 is progressive, -아/어 있다 a state."}},"하다":{"tag":{"ko":"보조 용언","en":"Auxiliary verb"},"short":{"ko":"하다","en":"to do"},"note":{"ko":"하다 는 ‘하다’ 예요. 명사에 붙어 동사를 만들어요 (공부하다).","en":"하다 means “to do”; it turns nouns into verbs (공부하다)."}},"거":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"것","en":"thing"},"note":{"ko":"거 는 것 의 입말이에요 (거야 = 것이야).","en":"거 is the spoken form of 것 (거야 = 것이야)."}},"것":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"것","en":"thing"},"note":{"ko":"것 은 ‘~하는 것, 일, 물건’ 이에요. 말할 때는 거.","en":"것 means “thing / what …”; spoken form 거."}},"수":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"수 (방법)","en":"way, can"},"note":{"ko":"수 는 -(으)ㄹ 수 있다 / 없다 의 ‘수’ (할 길) 예요.","en":"수 is the “way / means” in -(으)ㄹ 수 있다 / 없다 (can / cannot)."}},"않다":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"않다","en":"not"},"note":{"ko":"않다 는 -지 않다 로 부정을 만들어요.","en":"않다 makes negatives as -지 않다."}},"안":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"안 (부정)","en":"not"},"note":{"ko":"안 은 동사 앞의 짧은 부정 ‘안 ~하다’ 예요.","en":"안 before a verb is the short negative “not”."}},"못":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"못","en":"cannot"},"note":{"ko":"못 은 동사 앞에서 ‘못 ~하다’ (할 수 없음) 예요.","en":"못 before a verb means “cannot”."}},"못하다":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"못하다","en":"cannot"},"note":{"ko":"못하다 는 -지 못하다 로 ‘할 수 없음’ 을 나타내요.","en":"못하다 in -지 못하다 means “cannot”."}},"말다":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"말다","en":"don't, stop"},"note":{"ko":"말다 는 -지 말다 ‘~하지 마’ 예요.","en":"말다 in -지 말다 means “don't”."}},"아니다":{"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"아니다","en":"is not"},"note":{"ko":"아니다 는 ‘~이 아니다’ (이다 의 부정) 예요.","en":"아니다 is “is not” (the negative of 이다)."}},"싶다":{"tag":{"ko":"보조 용언","en":"Auxiliary verb"},"short":{"ko":"싶다 (바람)","en":"want"},"note":{"ko":"싶다 는 -고 싶다 ‘~하고 싶다’ 예요.","en":"싶다 in -고 싶다 means “want to”."}},"그":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"그","en":"that, the"},"note":{"ko":"그 는 ‘그’ (듣는 이 쪽, 앞에서 말한 것) 이에요.","en":"그 means “that / the” (near the listener, or already mentioned)."}},"이":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"이","en":"this"},"note":{"ko":"이 는 ‘이’ (가까운 것) 예요.","en":"이 means “this” (near the speaker)."}},"저#2":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"저","en":"that (far)"},"note":{"ko":"저 는 ‘저’ (멀리 있는 것) 예요.","en":"저 means “that over there”."}},"그것":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"그것","en":"that, it"},"note":{"ko":"그것 은 ‘그것’ (입말 그거) 이에요.","en":"그것 means “that / it” (spoken 그거)."}},"그거":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"그거","en":"that, it"},"note":{"ko":"그거 는 그것 의 입말이에요.","en":"그거 is the spoken 그것: “that / it”."}},"이것":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"이것","en":"this"},"note":{"ko":"이것 은 ‘이것’ (입말 이거) 이에요.","en":"이것 means “this” (spoken 이거)."}},"이거":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"이거","en":"this"},"note":{"ko":"이거 는 이것 의 입말이에요.","en":"이거 is the spoken 이것."}},"여기":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"여기","en":"here"},"note":{"ko":"여기 는 ‘여기, 이곳’ 이에요.","en":"여기 means “here”."}},"거기":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"거기","en":"there"},"note":{"ko":"거기 는 ‘거기, 그곳’ 이에요.","en":"거기 means “there”."}},"한":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"한 (하나의)","en":"one, a"},"note":{"ko":"한 은 ‘하나의’, 또 ‘약, 한 ~쯤’ 이에요 (한 시간).","en":"한 means “one / a”, or “about” (한 시간 = an hour or so)."}},"두":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"두","en":"two"},"note":{"ko":"두 는 ‘둘’ 이 명사 앞에 올 때의 꼴이에요.","en":"두 is “two” before a noun."}},"세":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"세","en":"three"},"note":{"ko":"세 는 ‘셋’ 이 명사 앞에 올 때의 꼴이에요.","en":"세 is “three” before a noun."}},"다른":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"다른","en":"other"},"note":{"ko":"다른 은 ‘다른’ 이에요.","en":"다른 means “other / different”."}},"모든":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"모든","en":"all, every"},"note":{"ko":"모든 은 ‘모든’ 이에요.","en":"모든 means “all / every”."}},"그런":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"그런","en":"such, that kind"},"note":{"ko":"그런 은 ‘그러한’ 이에요.","en":"그런 means “such / that kind of”."}},"이런":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"이런","en":"this kind"},"note":{"ko":"이런 은 ‘이러한’ 이에요.","en":"이런 means “this kind of”."}},"어떤":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"어떤","en":"what kind, some"},"note":{"ko":"어떤 은 ‘어떤’ 이에요.","en":"어떤 means “what kind of / some”."}},"무슨":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"무슨","en":"what"},"note":{"ko":"무슨 은 ‘무슨, 어떤’ 이에요.","en":"무슨 means “what (kind of)”."}},"몇":{"tag":{"ko":"기능어 · 관형사","en":"Function word · determiner"},"short":{"ko":"몇","en":"how many, a few"},"note":{"ko":"몇 은 ‘몇’ (수를 묻거나 조금) 이에요.","en":"몇 means “how many” or “a few”."}},"그리고":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그리고","en":"and"},"note":{"ko":"그리고 는 ‘그리고’ 예요 (문장과 문장을 이음).","en":"그리고 means “and” (between sentences)."}},"그래서":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그래서","en":"so"},"note":{"ko":"그래서 는 ‘그래서’ 예요.","en":"그래서 means “so / therefore”."}},"그런데":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그런데","en":"but, by the way"},"note":{"ko":"그런데 는 ‘그런데’ (말을 돌리거나 반대) 예요.","en":"그런데 means “but / by the way”."}},"하지만":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"하지만","en":"but"},"note":{"ko":"하지만 은 ‘하지만’ 이에요.","en":"하지만 means “but / however”."}},"그래도":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그래도","en":"still"},"note":{"ko":"그래도 는 ‘그래도’ 예요.","en":"그래도 means “still / even so”."}},"그러면":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그러면","en":"then"},"note":{"ko":"그러면 (그럼) 은 ‘그러면’ 이에요.","en":"그러면 (그럼) means “then / in that case”."}},"그러니까":{"tag":{"ko":"기능어 · 접속 부사","en":"Function word · connective adverb"},"short":{"ko":"그러니까","en":"so"},"note":{"ko":"그러니까 는 ‘그러니까’ 예요.","en":"그러니까 means “so / that is why”."}},"번":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"번","en":"time(s)"},"note":{"ko":"번 은 ‘~번’ (횟수) 이에요.","en":"번 counts times (“once, twice”)."}},"데":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"데 (곳)","en":"place"},"note":{"ko":"데 는 ‘곳, 경우’ 예요.","en":"데 means “place / case”."}},"때문":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"때문","en":"because of"},"note":{"ko":"때문 은 ‘~ 때문에’ (까닭) 예요.","en":"때문 means “because of”."}},"적":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"적 (때)","en":"time (ever)"},"note":{"ko":"적 은 -(으)ㄴ 적이 있다 의 ‘적’ (겪은 때) 이에요.","en":"적 is the “time” in -(으)ㄴ 적이 있다 (have ever done)."}},"줄":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"줄 (방법)","en":"how, that"},"note":{"ko":"줄 은 -(으)ㄹ 줄 알다 의 ‘줄’ (방법 · 사실) 이에요.","en":"줄 is the “how / that” in -(으)ㄹ 줄 알다."}},"중":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"중","en":"during, among"},"note":{"ko":"중 은 ‘~ 중에’ (가운데 · 하는 동안) 이에요.","en":"중 means “among / in the middle of”."}},"뭐":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"뭐","en":"what"},"note":{"ko":"뭐 는 ‘무엇’ 의 입말이에요.","en":"뭐 is the spoken 무엇: “what”."}},"무엇":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"무엇","en":"what"},"note":{"ko":"무엇 은 ‘무엇’ 이에요.","en":"무엇 means “what”."}},"누구":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"누구","en":"who"},"note":{"ko":"누구 는 ‘누구’ 예요.","en":"누구 means “who”."}},"어디":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"어디","en":"where"},"note":{"ko":"어디 는 ‘어디’ 예요.","en":"어디 means “where”."}},"언제":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"언제","en":"when"},"note":{"ko":"언제 는 ‘언제’ 예요.","en":"언제 means “when”."}},"왜":{"tag":{"ko":"기능어 · 부사","en":"Function word · adverb"},"short":{"ko":"왜","en":"why"},"note":{"ko":"왜 는 ‘왜’ 예요.","en":"왜 means “why”."}},"아무":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"아무","en":"any(one)"},"note":{"ko":"아무 는 부정과 함께 ‘아무 ~도’ 예요.","en":"아무 with a negative means “no … at all / anyone”."}},"아무것":{"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"아무것","en":"anything"},"note":{"ko":"아무것 은 ‘아무것도 (않다)’ 예요.","en":"아무것 with 도 and a negative means “nothing”."}},"만큼":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"만큼","en":"as much as"},"note":{"ko":"만큼 은 ‘~만큼’ (정도) 이에요.","en":"만큼 means “as much as”."}},"뿐":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"뿐","en":"only"},"note":{"ko":"뿐 은 ‘~뿐’ 이에요.","en":"뿐 means “only”."}},"채":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"채 (그대로)","en":"as it is"},"note":{"ko":"채 는 ‘~한 채로’ (그 상태 그대로) 예요.","en":"채 means “just as (it is) / while still”."}},"지":{"tag":{"ko":"기능어 · 의존 명사","en":"Function word · bound noun"},"short":{"ko":"지 (동안)","en":"since"},"note":{"ko":"지 는 ‘-(으)ㄴ 지 ~’ (그때부터 지난 시간) 예요.","en":"지 in -(으)ㄴ 지 means “since (a time)”."}},"계시다":{"tag":{"ko":"보조 용언","en":"Auxiliary verb"},"short":{"ko":"계시다","en":"to be (hon.)"},"note":{"ko":"계시다 는 있다 의 높임 ‘계시다’ 예요.","en":"계시다 is the honorific 있다."}}},"patterns":[{"id":"ko.itjana","seq":[{"lemma":["있다"],"fn":"지/EC\\+않/VX","role":"mark"}],"gap":0,"always":true,"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"있잖아","en":"you know"},"note":{"ko":"있잖아 는 말을 꺼낼 때의 ‘있잖아, 그거 알아?’ 예요 (있다 + -잖아).","en":"있잖아 opens a topic: “you know …” (있다 + -잖아)."}},{"id":"ko.l_su_itda","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["수"],"role":"mark"},{"lemma":["있다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 수 있다","en":"can"},"note":{"ko":"-(으)ㄹ 수 있다 = ‘~할 수 있다’ (능력 · 가능) 예요.","en":"-(으)ㄹ 수 있다 means “can / be able to”."}},{"id":"ko.l_su_eopda","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["수"],"role":"mark"},{"lemma":["없다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 수 없다","en":"cannot"},"note":{"ko":"-(으)ㄹ 수 없다 = ‘~할 수 없다’ 예요.","en":"-(으)ㄹ 수 없다 means “cannot”."}},{"id":"ko.geot_gatda","seq":[{"cls":["etm"],"role":"head"},{"lemma":["것","거"],"role":"mark"},{"lemma":["같다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~것 같다","en":"seems"},"note":{"ko":"-(으)ㄴ/는/(으)ㄹ 것 같다 = ‘~한/하는/할 것 같다’ (짐작) 예요. 단정하지 않고 부드럽게 말할 때도 써요.","en":"-(으)ㄴ/는/(으)ㄹ 것 같다 means “it seems / I think”; it also softens a statement."}},{"id":"ko.l_geoya","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["거","것"],"fn":"이/VCP","role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 거야","en":"will (probably)"},"note":{"ko":"-(으)ㄹ 거야 (거예요) = ‘~할 거야’ (앞일 · 짐작) 예요. 거 = 것 + 이다.","en":"-(으)ㄹ 거야 (거예요) means “will / probably”; 거 is short for 것 + 이다."}},{"id":"ko.n_jeok","seq":[{"cls":["etm_past"],"role":"head"},{"lemma":["적"],"role":"mark"},{"lemma":["있다","없다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~한 적 있다","en":"ever did"},"note":{"ko":"-(으)ㄴ 적이 있다 (없다) = ‘~한 적이 있다 (없다)’ (겪은 일) 예요.","en":"-(으)ㄴ 적이 있다 (없다) means “have (never) done before”."}},{"id":"ko.l_jul_past","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["줄"],"role":"mark"},{"lemma":["알다"],"fn":"었/EP","role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 줄 알았다","en":"thought (that)"},"note":{"ko":"-(으)ㄹ 줄 알았다 는 ‘~할 거라고 생각했다’ (그런데 아니었다) 예요.","en":"-(으)ㄹ 줄 알았다 means “I thought it would …” (but it did not)."}},{"id":"ko.l_jul","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["줄"],"role":"mark"},{"lemma":["알다","모르다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 줄 알다","en":"know how to"},"note":{"ko":"-(으)ㄹ 줄 알다 (모르다) = ‘~할 줄 알다 (모르다)’ (방법), 또는 ‘~할 거라고 생각하다’ 예요.","en":"-(으)ㄹ 줄 알다 (모르다) means “know how to”, or “think that … will”."}},{"id":"ko.go_itda","seq":[{"cls":["go"],"role":"head"},{"lemma":["있다","계시다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하고 있다","en":"-ing (now)"},"note":{"ko":"-고 있다 = ‘~하고 있다’ (지금 하는 중) 예요. 높이면 -고 계시다.","en":"-고 있다 means “is doing (right now)”; honorific -고 계시다."}},{"id":"ko.go_sipda","seq":[{"cls":["go"],"role":"head"},{"lemma":["싶다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하고 싶다","en":"want to"},"note":{"ko":"-고 싶다 = ‘~하고 싶다’ 예요. 남의 바람은 -고 싶어 하다.","en":"-고 싶다 means “want to”; for someone else, -고 싶어 하다."}},{"id":"ko.go_malda","seq":[{"cls":["go"],"role":"head"},{"lemma":["말다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"끝내 ~하다","en":"end up -ing"},"note":{"ko":"-고 말다 = ‘끝내 ~하고 말다’ (그렇게 되어 버림) 예요.","en":"-고 말다 means “end up doing / finally do”."}},{"id":"ko.eo_itda","seq":[{"cls":["eo"],"role":"head"},{"lemma":["있다","계시다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"(상태)","en":"(state)"},"note":{"ko":"-아/어 있다 = ‘~해 있다’ (일이 끝난 뒤 그 상태) 예요 (앉아 있다).","en":"-아/어 있다 describes a resulting state: “is (sitting, open …)”."}},{"id":"ko.eo_juda","seq":[{"cls":["eo"],"role":"head"},{"lemma":["주다","드리다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~해 주다","en":"for (someone)"},"note":{"ko":"-아/어 주다 (드리다) = ‘~해 주다’ (남을 위해) 예요.","en":"-아/어 주다 (드리다) means “do something for someone”."}},{"id":"ko.eo_boda","seq":[{"cls":["eo"],"role":"head"},{"lemma":["보다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~해 보다","en":"try -ing"},"note":{"ko":"-아/어 보다 = ‘~해 보다’ (시도 · 경험) 예요.","en":"-아/어 보다 means “try doing / have a go”."}},{"id":"ko.eo_beorida","seq":[{"cls":["eo"],"role":"head"},{"lemma":["버리다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"(다 해 버림)","en":"(completely)"},"note":{"ko":"-아/어 버리다 = ‘~해 버리다’ (다 끝냄 · 아쉬움) 예요.","en":"-아/어 버리다 means “do completely” (often with relief or regret)."}},{"id":"ko.eo_noda","seq":[{"cls":["eo"],"role":"head"},{"lemma":["놓다","두다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~해 놓다","en":"(in advance)"},"note":{"ko":"-아/어 놓다 (두다) = ‘~해 놓다’ (미리 해서 그대로 둠) 예요.","en":"-아/어 놓다 (두다) means “do in advance and leave it so”."}},{"id":"ko.eoya_hada","seq":[{"cls":["eoya"],"role":"head"},{"lemma":["하다","되다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~해야 한다","en":"must"},"note":{"ko":"-아/어야 하다 (되다) = ‘~해야 한다’ 예요.","en":"-아/어야 하다 (되다) means “must / have to”."}},{"id":"ko.ji_anta","seq":[{"cls":["ji"],"role":"head"},{"lemma":["않다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"~지 않다","en":"not"},"note":{"ko":"-지 않다 = ‘~하지 않다’ (부정) 예요. 짧게는 동사 앞에 안.","en":"-지 않다 means “not”; the short form is 안 before the verb."}},{"id":"ko.ji_mothada","seq":[{"cls":["ji"],"role":"head"},{"lemma":["못하다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"~지 못하다","en":"cannot"},"note":{"ko":"-지 못하다 = ‘~하지 못하다’ (할 수 없음) 예요. 짧게는 동사 앞에 못.","en":"-지 못하다 means “cannot / fail to”; the short form is 못 before the verb."}},{"id":"ko.ji_malda","seq":[{"cls":["ji"],"role":"head"},{"lemma":["말다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"~지 마","en":"don't"},"note":{"ko":"-지 말다 = ‘~하지 마’ (하지 말라는 말) 예요.","en":"-지 말다 means “don't” (asking someone not to)."}},{"id":"ko.ge_doeda","seq":[{"cls":["ge"],"role":"head"},{"lemma":["되다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하게 되다","en":"come to"},"note":{"ko":"-게 되다 = ‘~하게 되다’ (저절로 · 바뀌어 그렇게 됨) 예요.","en":"-게 되다 means “come to / end up / get to”."}},{"id":"ko.ge_hada","seq":[{"cls":["ge"],"role":"head"},{"lemma":["하다","만들다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하게 하다","en":"make (someone)"},"note":{"ko":"-게 하다 = ‘~하게 하다’ (시킴) 예요.","en":"-게 하다 means “make / let someone do”."}},{"id":"ko.ryeogo_hada","seq":[{"cls":["ryeogo"],"role":"head"},{"lemma":["하다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하려고 하다","en":"be about to"},"note":{"ko":"-(으)려고 하다 = ‘~하려고 하다’ (뜻 · 곧 할 일) 예요.","en":"-(으)려고 하다 means “intend to / be about to”."}},{"id":"ko.eodo_doeda","seq":[{"cls":["eodo"],"role":"head"},{"lemma":["되다","좋다","괜찮다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"해도 된다","en":"may"},"note":{"ko":"-아/어도 되다 = ‘~해도 된다’ (허락) 예요.","en":"-아/어도 되다 means “may / it is all right to”."}},{"id":"ko.myeon_an_doeda","seq":[{"cls":["myeon"],"role":"head"},{"lemma":["안"],"role":"mark"},{"lemma":["되다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"부정","en":"Negation"},"short":{"ko":"~면 안 된다","en":"must not"},"note":{"ko":"-(으)면 안 되다 = ‘~하면 안 된다’ (금지) 예요.","en":"-(으)면 안 되다 means “must not”."}},{"id":"ko.myeon_jota","seq":[{"cls":["myeon"],"role":"head"},{"lemma":["좋다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~면 좋겠다","en":"I wish"},"note":{"ko":"-(으)면 좋겠다 = ‘~하면 좋겠다’ (바람) 예요.","en":"-(으)면 좋겠다 means “I wish / it would be good if”."}},{"id":"ko.gi_ttaemun","seq":[{"cls":["etn_gi"],"role":"head"},{"lemma":["때문"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하기 때문에","en":"because"},"note":{"ko":"-기 때문에 = ‘~하기 때문에’ (까닭) 예요.","en":"-기 때문에 means “because”."}},{"id":"ko.gi_jeon","seq":[{"cls":["etn_gi"],"role":"head"},{"lemma":["전"],"role":"mark"}],"gap":1,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하기 전에","en":"before (doing)"},"note":{"ko":"-기 전에 = ‘~하기 전에’ 예요.","en":"-기 전에 means “before doing”."}},{"id":"ko.n_hu","seq":[{"cls":["etm_past"],"role":"head"},{"lemma":["후","뒤","다음"],"role":"mark"}],"gap":1,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~한 뒤에","en":"after (doing)"},"note":{"ko":"-(으)ㄴ 후에 (뒤에 · 다음에) = ‘~한 뒤에’ 예요.","en":"-(으)ㄴ 후에 (뒤에, 다음에) means “after doing”."}},{"id":"ko.neun_geoya","seq":[{"cls":["etm"],"role":"head"},{"lemma":["거","것"],"fn":"이/VCP","role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"(~인 거야)","en":"(it's that …)"},"note":{"ko":"-는 거야 · -(으)ㄴ 거야 는 ‘~하는 거야’: 앞의 일을 설명하거나 힘주어 말해요.","en":"-는 거야 / -(으)ㄴ 거야 explains or stresses: “it's that …”."}},{"id":"ko.l_ttae","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["때"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 때","en":"when"},"note":{"ko":"-(으)ㄹ 때 = ‘~할 때’ 예요.","en":"-(으)ㄹ 때 means “when / at the time of doing”."}},{"id":"ko.neun_jung","seq":[{"fn":"(^|\\+)는/ETM($|\\+)","role":"head"},{"lemma":["중"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~하는 중","en":"while (doing)"},"note":{"ko":"-는 중 = ‘~하는 중’ 이에요.","en":"-는 중 means “in the middle of doing”."}},{"id":"ko.lkka_hada","seq":[{"cls":["lkka"],"role":"head"},{"lemma":["하다","싶다"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할까 하다","en":"thinking of"},"note":{"ko":"-(으)ㄹ까 하다 (싶다) = ‘~할까 한다’ (마음먹는 중) 예요.","en":"-(으)ㄹ까 하다 (싶다) means “I'm thinking of doing”."}},{"id":"ko.l_ppun","seq":[{"cls":["etm_l"],"role":"head"},{"lemma":["뿐"],"role":"mark"}],"gap":0,"always":true,"tag":{"ko":"문형","en":"Construction"},"short":{"ko":"~할 뿐","en":"only"},"note":{"ko":"-(으)ㄹ 뿐 = ‘~할 뿐’ (그것 말고는 없음) 예요.","en":"-(으)ㄹ 뿐 means “only / nothing but”."}},{"id":"ko.nae","seq":[{"lemma":["나"],"fn":"^의/JKG","role":"mark"}],"gap":0,"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"내 (나의)","en":"my"},"note":{"ko":"내 는 나의 의 줄어든 꼴 ‘나의’ 예요 (내 그림 = 나의 그림). 내가 (주어) 의 내 와 꼴이 같아요.","en":"내 is short for 나의, “my” (내 그림 = my painting); it looks like the 내 of 내가 (I, subject)."}},{"id":"ko.ne","seq":[{"lemma":["너"],"fn":"^의/JKG","role":"mark"}],"gap":0,"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"네 (너의)","en":"your"},"note":{"ko":"네 는 너의 의 줄어든 꼴 ‘너의’ 예요.","en":"네 is short for 너의, “your”."}},{"id":"ko.je","seq":[{"lemma":["저"],"fn":"^의/JKG","role":"mark"}],"gap":0,"tag":{"ko":"기능어 · 대명사","en":"Function word · pronoun"},"short":{"ko":"제 (저의)","en":"my (polite)"},"note":{"ko":"제 는 저의 의 줄어든 꼴 ‘저의’ 예요.","en":"제 is short for 저의, the polite “my”."}}],"endings":{"어서/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해서","en":"so"},"note":{"ko":"-아/어서 는 ‘~해서’: 까닭 (그래서) 이나 차례 (~하고 나서) 를 이어요. 앞에 과거 -었- 을 붙이지 않아요.","en":"-아/어서 links a cause (“so”) or a sequence (“and then”); it never takes past -었-."},"show":true},"아서/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해서","en":"so"},"note":{"ko":"-아/어서 는 ‘~해서’: 까닭이나 차례를 이어요.","en":"-아/어서 links a cause (“so”) or a sequence (“and then”)."},"show":true},"서/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해서","en":"so"},"note":{"ko":"-아/어서 의 줄어든 꼴이에요 (가서 = 가 + 아서).","en":"A shortened -아/어서 (가서 = 가 + 아서): “so / and then”."},"show":true},"지만/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~지만","en":"but"},"note":{"ko":"-지만 은 ‘~지만’ (앞과 반대되는 말을 이음) 이에요.","en":"-지만 means “but / although”."},"show":true},"는데/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~는데","en":"and"},"note":{"ko":"-는데 · -(으)ㄴ데 는 뒷말의 배경을 깔거나 살짝 반대를 이어요 (‘~한데, ~하는데’).","en":"-는데 / -(으)ㄴ데 sets the background for what follows, or a mild contrast (“and / but”)."},"show":true},"ㄴ데/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~한데","en":"and"},"note":{"ko":"-(으)ㄴ데 는 배경 · 가벼운 반대를 이어요.","en":"-(으)ㄴ데 gives background or a mild contrast."},"show":true},"은데/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~은데","en":"and"},"note":{"ko":"-(으)ㄴ데 는 배경 · 가벼운 반대를 이어요.","en":"-(으)ㄴ데 gives background or a mild contrast."},"show":true},"면/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하면","en":"if"},"note":{"ko":"-(으)면 은 ‘~하면’ (조건 · 때) 이에요.","en":"-(으)면 means “if / when”."},"show":true},"으면/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하면","en":"if"},"note":{"ko":"-(으)면 은 ‘~하면’ (조건 · 때) 이에요.","en":"-(으)면 means “if / when”."},"show":true},"려면/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하려면","en":"to …"},"note":{"ko":"-(으)려면 은 ‘~하려면’ (그렇게 하고 싶으면) 이에요.","en":"-(으)려면 means “if you want to / in order to”."},"show":true},"어도/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해도","en":"even if"},"note":{"ko":"-아/어도 는 ‘~해도, ~하더라도’ 예요.","en":"-아/어도 means “even if / even though”."},"show":true},"아도/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해도","en":"even if"},"note":{"ko":"-아/어도 는 ‘~해도’ 예요.","en":"-아/어도 means “even if”."},"show":true},"니까/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하니까","en":"because"},"note":{"ko":"-(으)니까 는 ‘~하니까’ (까닭 · 알게 된 것) 예요. 뒤에 명령 · 권유가 올 수 있어요.","en":"-(으)니까 means “because / since” (a command can follow); also “when I did …, I found”."},"show":true},"으니까/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하니까","en":"because"},"note":{"ko":"-(으)니까 는 ‘~하니까’ 예요.","en":"-(으)니까 means “because / since”."},"show":true},"니/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하니","en":"as"},"note":{"ko":"-(으)니 는 ‘~하니, ~하니까’ (글말) 예요.","en":"-(으)니 means “as / since” (written style)."},"show":true},"으니/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하니","en":"as"},"note":{"ko":"-(으)니 는 ‘~하니까’ (글말) 예요.","en":"-(으)니 means “as / since”."},"show":true},"려고/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하려고","en":"to …"},"note":{"ko":"-(으)려고 는 ‘~하려고’ (목적) 예요.","en":"-(으)려고 means “in order to”."},"show":true},"면서/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하면서","en":"while"},"note":{"ko":"-(으)면서 는 ‘~하면서’ (두 일을 함께) 예요.","en":"-(으)면서 means “while (doing both)”."},"show":true},"다가/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하다가","en":"then"},"note":{"ko":"-다가 는 ‘~하다가’ (하던 일이 바뀜) 예요.","en":"-다가 means “while doing … (then something else)”."},"show":true},"도록/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하도록","en":"so that"},"note":{"ko":"-도록 은 ‘~하도록, ~할 때까지’ 예요.","en":"-도록 means “so that / until”."},"show":true},"자마자/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하자마자","en":"as soon as"},"note":{"ko":"-자마자 는 ‘~하자마자’ 예요.","en":"-자마자 means “as soon as”."},"show":true},"거든/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하거든","en":"if"},"note":{"ko":"이어 주는 -거든 은 ‘~하거든 (~하면)’ 이에요.","en":"Connective -거든 means “if / when”."},"show":true},"어야/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~해야","en":"only if"},"note":{"ko":"-아/어야 는 ‘~해야 (비로소)’ 예요. 뒤에 하다 · 되다가 오면 ‘~해야 한다’.","en":"-아/어야 means “only if”; with 하다 / 되다 it means “must”."},"show":true},"고/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하고","en":"and"},"note":{"ko":"-고 는 ‘~하고’ (나란히 · 차례) 예요.","en":"-고 means “and (then)”."},"show":true},"며/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하며","en":"and"},"note":{"ko":"-(으)며 는 ‘~하며’ (글말의 -고 · -면서) 예요.","en":"-(으)며 means “and / while” (written style)."},"show":true},"든/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~든","en":"whether"},"note":{"ko":"-든 (-든지) 는 ‘~하든 (어느 쪽이든)’ 이에요.","en":"-든 (-든지) means “whether / whatever”."},"show":true},"다고/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~라고","en":"that …"},"note":{"ko":"-다고 는 남의 말 · 생각을 옮기는 ‘~라고’ 예요 (간접 인용).","en":"-다고 quotes what someone says or thinks: “that …”."},"show":true},"라고/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~라고","en":"that …"},"note":{"ko":"-라고 는 ‘~라고’ (인용) 예요.","en":"-라고 quotes: “that … / called …”."},"show":true},"ㄴ다고/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~한다고","en":"that …"},"note":{"ko":"-(느)ㄴ다고 는 ‘~한다고’ (인용) 예요.","en":"-(느)ㄴ다고 quotes a statement: “that …”."},"show":true},"는지/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~하는지","en":"whether"},"note":{"ko":"-는지 · -(으)ㄴ지 는 ‘~하는지’ (모르는 것을 묻는 꼴) 예요.","en":"-는지 / -(으)ㄴ지 means “whether / how / what”."},"show":true},"ㄴ지/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~한지","en":"whether"},"note":{"ko":"-(으)ㄴ지 는 ‘~한지’ 예요.","en":"-(으)ㄴ지 means “whether / how”."},"show":true},"ㄹ지/EC":{"tag":{"ko":"연결 어미","en":"Connective ending"},"short":{"ko":"~할지","en":"whether"},"note":{"ko":"-(으)ㄹ지 는 ‘~할지’ 예요.","en":"-(으)ㄹ지 means “whether … will”."},"show":true},"었/EP":{"tag":{"ko":"어미 · 시제","en":"Ending · tense"},"short":{"ko":"~했다","en":"(past)"},"note":{"ko":"-었- (-았- · -였-) 은 과거를 나타내요.","en":"-었- (-았-, -였-) marks the past tense."},"show":true},"었었/EP":{"tag":{"ko":"어미 · 시제","en":"Ending · tense"},"short":{"ko":"~했었다","en":"(had)"},"note":{"ko":"-었었- 은 지금과 끊긴 먼 과거 ‘~했었다’ 예요.","en":"-었었- marks a more distant past: “had / used to”."},"show":true},"겠/EP":{"tag":{"ko":"어미 · 시제","en":"Ending · tense"},"short":{"ko":"~하겠다","en":"(will)"},"note":{"ko":"-겠- 은 뜻 (~하겠다) 이나 짐작 (~겠다) 을 나타내요.","en":"-겠- marks intention (“I will”) or a guess (“must be”)."},"show":true},"시/EP":{"tag":{"ko":"어미 · 높임","en":"Ending · honorific"},"short":{"ko":"(높임)","en":"(honorific)"},"note":{"ko":"-(으)시- 는 주어를 높여요 (가시다 = 가다 의 높임).","en":"-(으)시- honours the subject (가시다 = honorific of 가다)."},"show":false},"으시/EP":{"tag":{"ko":"어미 · 높임","en":"Ending · honorific"},"short":{"ko":"(높임)","en":"(honorific)"},"note":{"ko":"-(으)시- 는 주어를 높여요.","en":"-(으)시- honours the subject."},"show":false},"ㄹ게/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~할게","en":"I'll"},"note":{"ko":"-(으)ㄹ게 는 ‘~할게’ (듣는 이에게 하는 약속 · 뜻) 예요.","en":"-(으)ㄹ게 means “I'll (do it)”, a promise to the listener."},"show":true},"ㄹ까/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~할까?","en":"shall I?"},"note":{"ko":"-(으)ㄹ까 는 ‘~할까?’ (제안 · 짐작하는 물음) 예요.","en":"-(으)ㄹ까 means “shall I / shall we?” or “I wonder if”."},"show":true},"잖아/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~잖아","en":"you know"},"note":{"ko":"-잖아 는 ‘~잖아’ (듣는 이도 아는 것을 일깨움) 예요.","en":"-잖아 means “…, you know” (something the listener already knows)."},"show":true},"거든/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~거든","en":"you see"},"note":{"ko":"맺는 -거든 은 까닭을 덧붙이는 ‘~거든 (그래서 그래)’ 이에요.","en":"Final -거든 adds a reason: “…, you see”."},"show":false},"구나/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~구나","en":"(I see!)"},"note":{"ko":"-구나 는 새로 알게 된 것에 놀라는 ‘~구나’ 예요.","en":"-구나 shows a new realisation: “oh, so …!”."},"show":false},"네/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~네","en":"(oh, …)"},"note":{"ko":"-네 는 지금 보고 느낀 것을 말하는 ‘~네’ 예요.","en":"-네 remarks on something just noticed: “oh, …”."},"show":false},"자/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~하자","en":"let's"},"note":{"ko":"-자 는 ‘~하자’ (함께 하자는 말) 예요.","en":"-자 means “let's”."},"show":true},"세요/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~하세요","en":"please"},"note":{"ko":"-(으)세요 는 높여 부탁하거나 말하는 해요체예요.","en":"-(으)세요 is the polite 해요 form with honorific (requests, statements)."},"show":false},"어요/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(해요체)","en":"(polite)"},"note":{"ko":"-아/어요 는 해요체: 두루 높이는 끝맺음이에요.","en":"-아/어요 is the polite everyday ending (해요체)."},"show":false},"에요/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(해요체)","en":"(polite)"},"note":{"ko":"-이에요 · -예요 는 ‘~이에요’ (해요체) 예요.","en":"-이에요 / -예요 is the polite form of 이다."},"show":false},"예요/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(해요체)","en":"(polite)"},"note":{"ko":"-예요 는 ‘~예요’ (해요체) 예요.","en":"-예요 is the polite form of 이다."},"show":false},"ㅂ니다/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(합쇼체)","en":"(formal)"},"note":{"ko":"-(스)ㅂ니다 는 가장 격식 있는 끝맺음 (합쇼체) 이에요.","en":"-(스)ㅂ니다 is the most formal ending (합쇼체)."},"show":false},"습니다/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(합쇼체)","en":"(formal)"},"note":{"ko":"-습니다 는 가장 격식 있는 끝맺음이에요.","en":"-습니다 is the most formal ending."},"show":false},"어/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(반말)","en":"(casual)"},"note":{"ko":"-아/어 는 해체 (반말): 친한 사이의 끝맺음이에요.","en":"-아/어 is the casual ending (반말) between close people."},"show":false},"야/EF":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"(반말)","en":"(casual)"},"note":{"ko":"-야 는 ‘~이야’ (해체) 예요.","en":"-야 is the casual form of 이다."},"show":false},"만/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~만","en":"only"},"note":{"ko":"만 은 ‘~만, ~뿐’ 이에요.","en":"만 means “only”."},"show":true},"도/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~도","en":"also"},"note":{"ko":"도 는 ‘~도’ (또 · 심지어) 예요. 이 · 가 · 을 · 를 자리를 대신해요.","en":"도 means “also / even”; it replaces 이/가 and 을/를."},"show":true},"밖에/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~밖에","en":"only"},"note":{"ko":"밖에 는 뒤의 부정과 함께 ‘~밖에 (없다)’ = ‘~만’ 이에요.","en":"밖에 with a negative verb means “only / nothing but”."},"show":true},"뿐/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~뿐","en":"only"},"note":{"ko":"뿐 은 ‘~뿐’ 이에요.","en":"뿐 means “only / just”."},"show":true},"까지/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~까지","en":"until"},"note":{"ko":"까지 는 ‘~까지’ (끝 · 심지어) 예요.","en":"까지 means “until / up to / even”."},"show":true},"부터/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~부터","en":"from"},"note":{"ko":"부터 는 ‘~부터’ (시작) 예요.","en":"부터 means “from / starting with”."},"show":true},"마다/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~마다","en":"every"},"note":{"ko":"마다 는 ‘~마다’ 예요.","en":"마다 means “every / each”."},"show":true},"처럼/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~처럼","en":"like"},"note":{"ko":"처럼 은 ‘~처럼, ~같이’ 예요.","en":"처럼 means “like / as”."},"show":true},"만큼/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~만큼","en":"as … as"},"note":{"ko":"만큼 은 ‘~만큼’ (정도가 같음) 이에요.","en":"만큼 means “as much as”."},"show":true},"보다/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~보다","en":"than"},"note":{"ko":"보다 는 비교의 ‘~보다’ 예요.","en":"보다 means “than”."},"show":true},"에게/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~에게","en":"to"},"note":{"ko":"에게 (한테) 는 사람 · 동물에게 ‘~에게’ 예요.","en":"에게 (한테) means “to (a person or animal)”."},"show":true},"한테/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~한테","en":"to"},"note":{"ko":"한테 는 말할 때의 ‘~에게’ 예요.","en":"한테 is the spoken “to (a person)”."},"show":true},"한테서/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~한테서","en":"from"},"note":{"ko":"한테서 (에게서) 는 사람에게서 ‘~로부터’ 예요.","en":"한테서 (에게서) means “from (a person)”."},"show":true},"께/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~께","en":"to"},"note":{"ko":"께 는 높이는 ‘~에게’ 예요.","en":"께 is the honorific “to (someone)”."},"show":true},"께서/JKS":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~께서","en":"(hon. subject)"},"note":{"ko":"께서 는 높이는 주어 조사 (이 · 가 대신) 예요.","en":"께서 is the honorific subject particle (for 이/가)."},"show":false},"에서/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~에서","en":"at, from"},"note":{"ko":"에서 는 하는 곳 ‘~에서’, 또는 ‘~로부터’ 예요.","en":"에서 means “at (where something happens)” or “from”."},"show":false},"서/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~서","en":"at, from"},"note":{"ko":"서 는 에서 의 줄어든 꼴 (여기서) 이에요.","en":"서 is a short 에서 (여기서 = here, at this place)."},"show":false},"으로/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~으로","en":"to, by, as"},"note":{"ko":"(으)로 는 방향 (~로), 수단 (~로), 자격 (~로서) 이에요.","en":"(으)로 means “to (direction), by (means), as”."},"show":false},"로/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~로","en":"to, by, as"},"note":{"ko":"(으)로 는 방향 · 수단 · 자격이에요.","en":"(으)로 means “to, by, as”."},"show":false},"에/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~에","en":"at, to"},"note":{"ko":"에 는 때 · 곳 · 가는 곳의 ‘~에’ 예요.","en":"에 means “at / in / to” (time, place, destination)."},"show":false},"의/JKG":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~의","en":"’s, of"},"note":{"ko":"의 는 ‘~의’ (소유 · 소속) 예요.","en":"의 means “’s / of”."},"show":true},"와/JC":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~와","en":"and"},"note":{"ko":"와 · 과 (랑 · 하고) 는 ‘~와, ~하고’ 예요.","en":"와 / 과 (랑, 하고) mean “and / with”."},"show":true},"과/JC":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~과","en":"and"},"note":{"ko":"와 · 과 는 ‘~와’ 예요. 받침 뒤에 과.","en":"와 / 과 mean “and / with”; 과 after a consonant."},"show":true},"랑/JC":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~랑","en":"and"},"note":{"ko":"(이)랑 은 말할 때의 ‘~와’ 예요.","en":"(이)랑 is the spoken “and / with”."},"show":true},"와/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~와","en":"with"},"note":{"ko":"와 · 과 는 ‘~와 (함께)’ 예요.","en":"와 / 과 mean “with”."},"show":true},"과/JKB":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~과","en":"with"},"note":{"ko":"와 · 과 는 ‘~와 (함께)’ 예요.","en":"와 / 과 mean “with”."},"show":true},"이나/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~이나","en":"or"},"note":{"ko":"(이)나 는 ‘~이나’ (고르기 · 생각보다 많음) 예요.","en":"(이)나 means “or”, or “as many as”."},"show":true},"나/JX":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~나","en":"or"},"note":{"ko":"(이)나 는 ‘~나’ 예요.","en":"(이)나 means “or / about”."},"show":true},"라도/EC":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~라도","en":"even"},"note":{"ko":"(이)라도 는 ‘~라도’ (아쉬운 대로) 예요.","en":"(이)라도 means “even / at least”."},"show":true},"아/JKV":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~아 (부름)","en":"(calling)"},"note":{"ko":"아 · 야 는 친한 사람을 부르는 조사예요 (테오야).","en":"아 / 야 are used when calling someone close (테오야)."},"show":false},"야/JKV":{"tag":{"ko":"조사","en":"Particle"},"short":{"ko":"~야 (부름)","en":"(calling)"},"note":{"ko":"야 는 부르는 조사예요.","en":"야 is the calling particle."},"show":false},"은/JX":{"tag":{"ko":"조사 · 주제","en":"Particle · topic"},"short":{"ko":"(주제)","en":"(topic)"},"note":{"ko":"은 · 는 은 주제 ‘~은/는’: 이야기의 대상이나 다른 것과의 대비를 나타내요.","en":"은 / 는 mark the topic, or a contrast with something else."},"show":false},"는/JX":{"tag":{"ko":"조사 · 주제","en":"Particle · topic"},"short":{"ko":"(주제)","en":"(topic)"},"note":{"ko":"은 · 는 은 주제 ‘~은/는’ 이에요. 받침 없으면 는.","en":"은 / 는 mark the topic or a contrast; 는 after a vowel."},"show":false},"ㄴ/JX":{"tag":{"ko":"조사 · 주제","en":"Particle · topic"},"short":{"ko":"(주제)","en":"(topic)"},"note":{"ko":"ㄴ 은 는 의 줄어든 꼴 (난 = 나는) 이에요.","en":"ㄴ is a short 는 (난 = 나는)."},"show":false},"이/JKS":{"tag":{"ko":"조사 · 주어","en":"Particle · subject"},"short":{"ko":"(주어)","en":"(subject)"},"note":{"ko":"이 · 가 는 주어 조사: 새 정보 · 누가 하는지를 짚어요.","en":"이 / 가 mark the subject, often new information."},"show":false},"가/JKS":{"tag":{"ko":"조사 · 주어","en":"Particle · subject"},"short":{"ko":"(주어)","en":"(subject)"},"note":{"ko":"이 · 가 는 주어 조사예요. 받침 없으면 가.","en":"이 / 가 mark the subject; 가 after a vowel."},"show":false},"이/JKC":{"tag":{"ko":"조사 · 주어","en":"Particle · subject"},"short":{"ko":"(되다 · 아니다 앞)","en":"(complement)"},"note":{"ko":"되다 · 아니다 앞의 이 · 가 는 ‘~이 (되다 / 아니다)’ 예요.","en":"이 / 가 before 되다 / 아니다 mark what something becomes or is not."},"show":false},"가/JKC":{"tag":{"ko":"조사 · 주어","en":"Particle · subject"},"short":{"ko":"(되다 · 아니다 앞)","en":"(complement)"},"note":{"ko":"되다 · 아니다 앞의 이 · 가 예요.","en":"이 / 가 before 되다 / 아니다."},"show":false},"을/JKO":{"tag":{"ko":"조사 · 목적어","en":"Particle · object"},"short":{"ko":"(목적어)","en":"(object)"},"note":{"ko":"을 · 를 은 목적어 조사 ‘~을/를’ 이에요.","en":"을 / 를 mark the object."},"show":false},"를/JKO":{"tag":{"ko":"조사 · 목적어","en":"Particle · object"},"short":{"ko":"(목적어)","en":"(object)"},"note":{"ko":"을 · 를 은 목적어 조사예요. 받침 없으면 를.","en":"을 / 를 mark the object; 를 after a vowel."},"show":false},"ㄹ/JKO":{"tag":{"ko":"조사 · 목적어","en":"Particle · object"},"short":{"ko":"(목적어)","en":"(object)"},"note":{"ko":"ㄹ 은 를 의 줄어든 꼴 (날 = 나를) 이에요.","en":"ㄹ is a short 를 (날 = 나를)."},"show":false},"이/VCP":{"tag":{"ko":"맺음 어미","en":"Sentence ending"},"short":{"ko":"~이다","en":"is"},"note":{"ko":"이다 는 ‘~이다’ 예요. 명사에 붙어 써요 (편지야 = 편지 + 이야).","en":"이다 means “to be (something)”; it attaches to the noun (편지야 = 편지 + 이야)."},"show":false},"기/ETN":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~하기","en":"-ing (noun)"},"note":{"ko":"-기 는 동사를 명사처럼 만들어요 (그리기 = 그리는 것).","en":"-기 turns a verb into a noun (그리기 = drawing)."},"show":false},"ㅁ/ETN":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~함","en":"-ing (noun)"},"note":{"ko":"-(으)ㅁ 은 동사를 명사처럼 만들어요 (글말).","en":"-(으)ㅁ turns a verb into a noun (written style)."},"show":false},"는/ETM":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~하는","en":"(-ing …)"},"note":{"ko":"-는 은 명사를 꾸미는 현재 ‘~하는’ 이에요.","en":"-는 makes a present modifier: “that is doing”."},"show":false},"ㄴ/ETM":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~한","en":"(that …)"},"note":{"ko":"-(으)ㄴ 은 동사에 붙으면 과거 ‘~한’, 형용사에 붙으면 ‘~인’ 이에요.","en":"-(으)ㄴ on a verb means “that did”; on an adjective it is a plain modifier."},"show":false},"은/ETM":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~은","en":"(that …)"},"note":{"ko":"-(으)ㄴ 은 꾸미는 꼴 ‘~한, ~은’ 이에요.","en":"-(으)ㄴ is a modifier ending: “that did / that is”."},"show":false},"ㄹ/ETM":{"tag":{"ko":"어미 · 꾸밈","en":"Ending · modifier"},"short":{"ko":"~할","en":"(to …)"},"note":{"ko":"-(으)ㄹ 은 앞일 · 짐작의 꾸미는 꼴 ‘~할’ 이에요.","en":"-(으)ㄹ is a future 