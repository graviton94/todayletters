{"_doc":"Idioms of this series for this learning language (scripts/notes.py from scripts/idioms/<series>[_deck].txt). lem = lexicon keys (lowercase, space separated) matched in a row against gloss tokens; t = shown form; ko/en = short meaning; note_ko/note_en = optional one-line note; n = letters it appears in; first = [letter id, message index]. Patterns win over idioms, idioms over anchors.","lang":"fr","checked":false,"idioms":[{"lem":"tout à faire","t":"tout à fait","ko":"완전히, 정말","en":"quite, completely","n":4,"first":["c2-l2",0]},{"lem":"au moins","t":"au moins","ko":"적어도","en":"at least","n":5,"first":["c1-l1",1]},{"lem":"pour le moins","t":"pour le moins","ko":"적어도","en":"at the very least","n":1,"first":["c1-l1",0]},{"lem":"en train de","t":"en train de","ko":"~하는 중","en":"in the middle of","note_ko":"être en train de + 동사 원형 = ‘~하고 있는 중이다’ 예요.","note_en":"Être en train de + infinitive = “to be busy doing”.","n":3,"first":["c2-l7",0]},{"lem":"en plein","t":"en plein","ko":"한가운데","en":"in the middle of, full","n":8,"first":["c1-l3",0]},{"lem":"en plein air","t":"en plein air","ko":"야외에서","en":"outdoors","n":2,"first":["c1-l3",0]},{"lem":"en plein soleil","t":"en plein soleil","ko":"땡볕 아래","en":"in full sun","n":2,"first":["c1-l6",1]},{"lem":"dans le fond","t":"dans le fond","ko":"사실은","en":"at bottom, really","n":5,"first":["c1-l5",2]},{"lem":"de temps en temps","t":"de temps en temps","ko":"가끔","en":"from time to time","n":1,"first":["c6-l4",4]},{"lem":"beaucoup de","t":"beaucoup de","ko":"많은","en":"a lot of","n":5,"first":["c1-l3",4]},{"lem":"un peu de","t":"un peu de","ko":"약간의","en":"a bit of","n":4,"first":["c1-l2",3]},{"lem":"à peu près","t":"à peu près","ko":"거의, 대략","en":"roughly","n":1,"first":["c6-l2",0]},{"lem":"tout de même","t":"tout de même","ko":"그래도","en":"all the same","n":1,"first":["c2-l6",4]},{"lem":"en effet","t":"En effet","ko":"사실, 과연","en":"indeed","n":1,"first":["c4-l7",2]},{"lem":"par conséquent","t":"par conséquent","ko":"따라서","en":"consequently","n":1,"first":["c6-l2",4]},{"lem":"quand même","t":"quand même","ko":"그래도","en":"even so","n":1,"first":["c1-l3",4]},{"lem":"à cause de","t":"à cause de","ko":"~ 때문에","en":"because of","n":1,"first":["c4-l7",3]},{"lem":"au lieu de","t":"au lieu de","ko":"~ 대신에","en":"instead of","n":2,"first":["c2-l6",1]},{"lem":"à travers","t":"à travers","ko":"~을 가로질러","en":"through","n":2,"first":["c6-l1",2]},{"lem":"au-dessus de","t":"au-dessus de","ko":"~ 위에","en":"above","n":1,"first":["c6-l1",2]},{"lem":"autour de","t":"autour de","ko":"~ 주위에","en":"around","n":1,"first":["c2-l3",0]},{"lem":"à côté de","t":"à côté de","ko":"~ 옆에","en":"next to","n":3,"first":["c4-l5",2]},{"lem":"plus ou moins","t":"plus ou moins","ko":"다소","en":"more or less","n":1,"first":["c1-l5",1]},{"lem":"le plus","t":"le plus","ko":"가장","en":"the most","n":5,"first":["c1-l5",0]},{"lem":"tout le monde","t":"tout le monde","ko":"모두","en":"everybody","n":2,"first":["c2-l7",3]},{"lem":"à le fois","t":"à la fois","ko":"동시에","en":"at once","n":2,"first":["c5-l3",1]},{"lem":"à présent","t":"à présent","ko":"지금","en":"now","n":3,"first":["c7-l2",1]},{"lem":"un fois","t":"une fois","ko":"한 번","en":"once","n":2,"first":["c3-l2",0]},{"lem":"encore un fois","t":"encore une fois","ko":"한 번 더","en":"once more","n":2,"first":["c3-l2",0]},{"lem":"il me sembler","t":"il me semblait","ko":"내 생각엔","en":"it seems to me","n":3,"first":["c1-l3",2]},{"lem":"de nouveau","t":"de nouveau","ko":"다시","en":"again","n":1,"first":["c7-l7",2]},{"lem":"à le campagne","t":"à la campagne","ko":"시골에서","en":"in the country","n":1,"first":["c1-l4",2]},{"lem":"ce que","t":"ce que","ko":"~하는 것","en":"what","n":15,"first":["c1-l4",2]},{"lem":"ce qui","t":"ce qui","ko":"~하는 것","en":"what","n":10,"first":["c1-l2",0]},{"lem":"en somme","t":"en somme","ko":"요컨대","en":"in short","n":2,"first":["c4-l1",2]},{"lem":"le plupart","t":"la plupart","ko":"대부분","en":"most","n":1,"first":["c8-l3",4]},{"lem":"de même","t":"de même","ko":"마찬가지로","en":"likewise","n":4,"first":["c2-l6",4]},{"lem":"dès que","t":"dès que","ko":"~하자마자","en":"as soon as","n":1,"first":["c5-l2",2]},{"lem":"bien que","t":"bien que","ko":"~이지만","en":"although","n":4,"first":["c5-l5",3]},{"lem":"pour que","t":"pour qu'","ko":"~하도록","en":"so that","n":1,"first":["c7-l5",2]},{"lem":"au bout de","t":"Au bout de","ko":"~ 끝에","en":"at the end of","n":1,"first":["c2-l2",3]},{"lem":"de bon heure","t":"de bonne heure","ko":"일찍","en":"early","n":1,"first":["c4-l4",0]},{"lem":"poignée de main","t":"Poignée de main","ko":"악수","en":"handshake","n":1,"first":["c5-l1",4]},{"lem":"de côté","t":"de côté","ko":"옆으로, 제쳐 두고","en":"aside","n":1,"first":["c6-l4",2]},{"lem":"quand bien même","t":"quand bien même","ko":"설령 ~라 해도","en":"even if","n":1,"first":["c4-l4",3]},{"lem":"pour ce qui être du","t":"Pour ce qui est du","ko":"~에 관해 말하자면","en":"as for","note_ko":"pour ce qui est du ~ = '~에 관해서는' (du = de + le). 이야기 주제를 꺼낼 때 문장 앞에 써요.","note_en":"Pour ce qui est du … = “as for the …” (du = de + le).","n":1,"first":["c1-l2",0]}]}
